DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=votovivo
# TEST_MODE=True limita a carga a um dataset reduzido — use apenas em desenvolvimento
TEST_MODE=False
PORTAL_TRANSPARENCIA_API_KEY=

# Configurações de Data de Busca (ETL)
# 2023-01 = início do mandato atual da Câmara; necessário para os dashboards
# "de mandato" (total de emendas, top gastos, comparações).
ANO_INICIO_ETL=2023
MES_INICIO_ETL=1

# Staging (cache HTTP em disco) — protege o progresso contra retrabalho:
#   gravar -> toda resposta 200 é salva em ETL_HTTP_CACHE_DIR
#   ler    -> reprocessa a partir do disco sem bater na API (o que faltar é buscado e salvo)
#   vazio  -> desligado
ETL_HTTP_CACHE=gravar
ETL_HTTP_CACHE_DIR=staging/http_cache

# Paralelismo do fetch HTTP (a gravação no banco continua sequencial, em ordem).
# Comece com 4 e observe HTTP 429 no log; 1 desliga o paralelismo.
ETL_WORKERS=4
ETL_TAMANHO_LOTE=40

# Purga do cache do CDN ao fim da carga. Sem estas duas variáveis a purga é
# apenas ignorada (é o caso do ambiente local, que não tem CDN na frente).
#
# O token precisa de UMA permissão apenas: Zone > Cache Purge > Purge, restrita
# à zona do projeto. Não use a Global API Key — ela dá acesso à conta inteira.
# O ZONE_ID está no canto inferior direito do Overview da zona.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
